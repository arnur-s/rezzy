# Browser SPA configuration. Copy this file to .env.
# Every VITE_* value is public and included in browser-delivered JavaScript.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: required only for WhatsApp Embedded Signup.
VITE_WHATSAPP_APP_ID=
VITE_WHATSAPP_CONFIG_ID=

# Optional: keep aligned with WHATSAPP_GRAPH_VERSION in Edge Functions.
VITE_WHATSAPP_GRAPH_VERSION=

# Optional: Web Push (desktop notifications). Public VAPID key used by the
# browser to subscribe. Desktop notifications degrade gracefully when unset.
# Generate a key pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Edge Function secrets are not loaded from this root file.
# Put these names in supabase/functions/.env for local development, or set them
# in the linked Supabase project's Edge Function secrets:
# WHATSAPP_APP_ID
# WHATSAPP_APP_SECRET
# WHATSAPP_VERIFY_TOKEN
# WHATSAPP_GRAPH_VERSION
# VAPID_PUBLIC_KEY      (same value as VITE_VAPID_PUBLIC_KEY)
# VAPID_PRIVATE_KEY     (keep secret — never expose to the browser)
# VAPID_SUBJECT         (e.g. mailto:notifications@yourdomain.com)
# PUSH_DISPATCH_SECRET  (shared secret the webhooks use to call send-message-push;
#                        generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
